<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ticket Conversation</title>
<style>
/* ============================================================
   VelOps design system v2 tokens — ported from the approved
   support-portal mockup. Saira is optional inside the MDA
   iframe: system fonts are the fallback (no external requests).
   ============================================================ */
:root{
  --vel-yellow:      #F5D920;
  --vel-yellow-600:  #E3C400;
  --vel-yellow-700:  #C9A300;
  --vel-yellow-tint: #FBF4CC;
  --vel-ink:         #111111;
  --vel-purple:      #742774;
  --vel-purple-soft: #F1E4F0;
  --vel-white:       #FFFFFF;
  --vel-50:  #F6F5F1;
  --vel-100: #E7E5DF;
  --vel-200: #D7D4CC;
  --vel-300: #BCB9B0;
  --vel-400: #9A968D;
  --vel-500: #6F6C64;
  --vel-600: #4A4842;
  --vel-warning:    #D9881A; --vel-warning-bg:  #FBEBD0;
  --vel-danger:     #CE3A2B; --vel-danger-bg:   #F8DEDA;
  --vel-info:       #2F6DB5; --vel-info-bg:     #DFEBF8;
  --vel-font-ui:   'Saira', 'Segoe UI', system-ui, -apple-system, sans-serif;
  --vel-font-head: 'Saira Condensed', 'Saira', 'Segoe UI', system-ui, sans-serif;
  --r-sm: 12px; --r-md: 16px; --r-pill: 999px;
}
*{ box-sizing:border-box; margin:0; padding:0; }
html,body{ height:100%; }
body{
  font-family: var(--vel-font-ui);
  background: var(--vel-white);
  color: var(--vel-ink);
  font-size: 14px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}
button{ font-family: inherit; font-size: inherit; cursor: pointer; }
textarea{ font-family: inherit; font-size: inherit; color: inherit; }

.panel{ display:flex; flex-direction:column; height:100vh; }

/* ---------- status strip (loading / errors) ---------- */
.strip{ padding: 8px 26px; font-size:13px; display:none; }
.strip.show{ display:block; }
.strip--loading{ color: var(--vel-500); background: var(--vel-50); }
.strip--error{ color: var(--vel-danger); background: var(--vel-danger-bg); }

/* ---------- empty states ---------- */
.emptystate{
  flex:1; display:none; align-items:center; justify-content:center;
  flex-direction:column; gap:8px; text-align:center; padding: 32px 24px;
  color: var(--vel-400);
}
.emptystate.show{ display:flex; }
.emptystate h2{ font-weight:600; font-size:16px; color: var(--vel-600); }
.emptystate p{ font-size:13.5px; max-width: 380px; }

/* ---------- thread (ported from mockup, chat-aligned) ---------- */
.thread{
  flex:1; overflow-y:auto; padding: 18px 26px 22px;
  display:none; flex-direction:column; gap:16px;
}
.thread.show{ display:flex; }
.msg{ display:flex; gap:13px; max-width: 82%; }
.msg--cust{ align-self:flex-start; }
.msg--vel{ align-self:flex-end; flex-direction:row-reverse; }
.msg__avatar{
  width:36px; height:36px; border-radius:50%; flex-shrink:0;
  display:flex; align-items:center; justify-content:center;
  font-family: var(--vel-font-head); font-weight:700; font-size:14px;
}
.msg--cust .msg__avatar{ background: var(--vel-100); color: var(--vel-600); }
.msg--vel .msg__avatar{ background: var(--vel-purple); color:#fff; }
.msg--internal .msg__avatar{ background: var(--vel-warning-bg); color: var(--vel-warning); }
.msg__body{ flex:1; min-width:0; }
.msg--vel .msg__body{ display:flex; flex-direction:column; align-items:flex-end; }
.msg__who{ display:flex; align-items:baseline; gap:8px; flex-wrap:wrap; }
.msg__who .name{ font-weight:600; font-size:14px; }
.msg__who .tag{
  font-family: var(--vel-font-head); font-weight:700; font-size:10.5px;
  letter-spacing:.1em; text-transform:uppercase; color: var(--vel-purple);
  background: var(--vel-purple-soft); border-radius:4px; padding:1px 7px;
}
.msg__who .when{ font-size:12px; color: var(--vel-400); }
.msg__bubble{
  margin-top:5px; background: var(--vel-50); border:1px solid var(--vel-100);
  border-radius: var(--r-md); padding: 11px 15px; font-size:14px;
  white-space:pre-wrap; overflow-wrap:break-word; max-width:100%;
}
.msg--vel .msg__bubble{ background: var(--vel-yellow-tint); border-color: var(--vel-yellow-600); }
.msg--internal .msg__bubble{
  background: var(--vel-warning-bg); border:1px dashed var(--vel-warning);
}
.msg--internal .tag{
  color: var(--vel-warning); background: transparent; border:1px solid var(--vel-warning);
}

/* attachment chips + inline image previews */
.atts{ margin-top:7px; display:flex; flex-wrap:wrap; gap:8px; }
.msg--vel .atts{ justify-content:flex-end; }
.att{
  display:inline-flex; align-items:center; gap:7px;
  border:1px solid var(--vel-200); background: var(--vel-white);
  border-radius: var(--r-pill); padding: 4px 12px;
  font-size:12.5px; font-weight:500; color: var(--vel-600); max-width: 260px;
}
.att span{ overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.att svg{ flex-shrink:0; color: var(--vel-400); }
.att--note{ border-style:dashed; border-color: var(--vel-warning); color: var(--vel-warning); }
.attimg{
  display:block; margin-top:7px; max-width: 280px; max-height: 200px;
  border-radius: 10px; border:1px solid var(--vel-200); object-fit:cover;
}
.ticketatts{ display:none; flex-wrap:wrap; gap:8px; }
.ticketatts.show{ display:flex; }
.ticketatts__label{
  width:100%; font-family: var(--vel-font-head); font-weight:700; font-size:11px;
  letter-spacing:.12em; text-transform:uppercase; color: var(--vel-400);
}

/* ---------- composer (ported from mockup) ---------- */
.composer{ border-top:1px solid var(--vel-100); padding: 14px 26px 18px; display:none; }
.composer.show{ display:block; }
.composer.is-internal textarea{
  border-color: var(--vel-warning); background: var(--vel-warning-bg);
}
.composer textarea{
  width:100%; min-height:72px; resize:vertical;
  border:1px solid var(--vel-200); border-radius: var(--r-md);
  padding: 11px 14px; outline:none; background: var(--vel-white);
}
.composer textarea:focus{ border-color: var(--vel-400); box-shadow: 0 0 0 3px rgba(245,217,32,.45); }
.composer.is-internal textarea:focus{
  border-color: var(--vel-warning); box-shadow: 0 0 0 3px rgba(217,136,26,.25);
}
.composer__pending{ display:flex; flex-wrap:wrap; gap:8px; margin-top:9px; }
.composer__pending .att button{
  border:0; background:none; color: inherit; padding:0; line-height:1; font-size:14px;
}
.composer__row{ display:flex; align-items:center; gap:14px; margin-top:10px; }
.composer__row .spacer{ flex:1; }
.toggle{
  display:flex; align-items:center; gap:7px; font-size:13px; color: var(--vel-600);
  border:1px solid var(--vel-200); border-radius: var(--r-pill);
  background: var(--vel-white); padding: 5px 13px; font-weight:500; user-select:none;
  cursor:pointer;
}
.toggle input{ accent-color: var(--vel-warning); }
.toggle.is-on{
  background: var(--vel-warning-bg); border-color: var(--vel-warning);
  color: var(--vel-warning); font-weight:600;
}
.btn{
  display:inline-flex; align-items:center; gap:7px;
  border-radius: var(--r-sm); padding: 8px 16px;
  font-weight:600; font-size:13.5px; border:1px solid transparent;
}
.btn:disabled{ opacity:.55; cursor:default; }
.btn--primary{ background: var(--vel-yellow); color: var(--vel-ink); }
.btn--primary:hover:not(:disabled){ background: var(--vel-yellow-600); }
.btn--internal{ background: var(--vel-warning); color:#fff; }
.btn--ghost{ background: var(--vel-white); border-color: var(--vel-200); color: var(--vel-ink); }
.btn--ghost:hover:not(:disabled){ background: var(--vel-50); }
.hint{ font-size:12px; color: var(--vel-400); }
.hidden{ display:none !important; }
</style>
</head>
<body>
<div class="panel">
  <div class="strip strip--loading" id="loading">Loading conversation…</div>
  <div class="strip strip--error" id="error"></div>

  <div class="emptystate" id="emptyUnsaved">
    <h2>Save the ticket first</h2>
    <p>The conversation panel activates once the ticket exists. Save the record and the thread appears here.</p>
  </div>

  <div class="emptystate" id="emptyThread">
    <h2>No messages yet</h2>
    <p>Start the conversation below — public replies are visible to the customer on the portal, internal notes stay in the team.</p>
  </div>

  <div class="thread" id="thread">
    <div class="ticketatts" id="ticketAtts"></div>
    <div style="display:contents" id="msgs"></div>
  </div>

  <div class="composer" id="composer">
    <textarea id="body" placeholder="Write a reply to the customer…"></textarea>
    <div class="composer__pending" id="pending"></div>
    <div class="composer__row">
      <label class="toggle" id="toggleWrap">
        <input type="checkbox" id="internalChk"> Internal note (not visible to customer)
      </label>
      <button class="btn btn--ghost" type="button" id="attachBtn" title="Attach files">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg>
        Attach
      </button>
      <input type="file" id="fileInput" class="hidden" multiple>
      <span class="spacer"></span>
      <span class="hint" id="composerHint">Public replies are visible to the customer on the portal.</span>
      <button class="btn btn--primary" type="button" id="sendBtn">Send</button>
    </div>
  </div>
</div>

<script>
(function () {
  "use strict";

  // ── constants (VelopsCustomers schema contract) ─────────────────────────────
  var API = "/api/data/v9.2/";
  var DIRECTION_CUSTOMER = 122690000;
  var DIRECTION_VELOPS = 122690001;
  var STATUS_NEW = 1;
  var STATUS_IN_REVIEW = 122690001;

  // ── parent Xrm (this page runs inside the MDA form iframe) ──────────────────
  /** @type {any} */
  var Xrm = null;
  try { Xrm = window.parent ? window.parent.Xrm : null; } catch (e) { /* cross-origin — leave null */ }

  var state = {
    ticketId: null,
    statuscode: null,
    pendingFiles: [],   // File[] queued in the composer
    sending: false
  };

  function $(id) { return document.getElementById(id); }

  function esc(s) {
    return String(s == null ? "" : s)
      .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
  }

  function showError(message) {
    var el = $("error");
    el.textContent = message;
    el.classList.add("show");
  }
  function clearError() { $("error").classList.remove("show"); }
  function setLoading(on, label) {
    var el = $("loading");
    el.textContent = label || "Loading conversation…";
    el.classList.toggle("show", !!on);
  }

  // PassParameters=true → the form appends id/type params; the record id may
  // arrive as ?id={GUID} or nested inside the data= parameter.
  function getTicketId() {
    var search = new URLSearchParams(window.location.search);
    var id = search.get("id");
    if (!id) {
      var data = search.get("data");
      if (data) {
        try {
          var inner = new URLSearchParams(decodeURIComponent(data));
          id = inner.get("id") || (/^[0-9a-fA-F{}-]{36,38}$/.test(data.replace(/%7B|%7D/gi, "")) ? data : null);
        } catch (e) { /* malformed data param */ }
      }
    }
    if (!id) return null;
    id = id.replace(/[{}]/g, "").toLowerCase();
    return /^[0-9a-f-]{36}$/.test(id) ? id : null;
  }

  function clientUrl() { return Xrm.Utility.getGlobalContext().getClientUrl(); }
  function userName() {
    try { return Xrm.Utility.getGlobalContext().userSettings.userName || "VelOps"; }
    catch (e) { return "VelOps"; }
  }

  function initials(name) {
    var parts = String(name || "?").trim().split(/\s+/).slice(0, 2);
    return parts.map(function (p) { return p.charAt(0).toUpperCase(); }).join("") || "?";
  }

  function fmtWhen(iso) {
    if (!iso) return "";
    var d = new Date(iso);
    if (isNaN(d.getTime())) return "";
    return d.toLocaleString(undefined, {
      day: "2-digit", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit"
    });
  }

  function webApiError(e) {
    if (!e) return "Unknown error";
    return e.message || (e.error && e.error.message) || String(e);
  }

  // ── data loading ────────────────────────────────────────────────────────────
  function retrieveAll(entity, options) {
    return Xrm.WebApi.retrieveMultipleRecords(entity, options).then(function (r) {
      return r.entities || [];
    });
  }

  function loadTicket() {
    return Xrm.WebApi.retrieveRecord("gd_supportticket", state.ticketId, "?$select=statuscode,statecode")
      .then(function (t) { state.statuscode = t.statuscode; });
  }

  function loadNoteAttachments(notes) {
    if (!notes.length) return Promise.resolve([]);
    // Annotations on internal notes (HasNotes) — or-chain the note ids.
    var filter = notes.map(function (n) {
      return "_objectid_value eq " + n.gd_internalnoteid;
    }).join(" or ");
    return retrieveAll("annotation",
      "?$select=annotationid,filename,mimetype,_objectid_value&$filter=isdocument eq true and (" + filter + ")"
    ).catch(function () { return []; }); // non-blocking: chips just stay hidden
  }

  function loadThread() {
    setLoading(true);
    clearError();
    var base = "&$filter=_gd_ticket_value eq " + state.ticketId + "&$orderby=createdon asc";
    return Promise.all([
      loadTicket(),
      retrieveAll("gd_supportmessage",
        "?$select=gd_supportmessageid,gd_name,gd_body,gd_direction,gd_authorname,createdon" + base),
      retrieveAll("gd_internalnote",
        "?$select=gd_internalnoteid,gd_name,gd_body,gd_authorname,createdon" + base),
      retrieveAll("gd_ticketattachment",
        "?$select=gd_ticketattachmentid,gd_name,gd_mimetype,gd_isimage,_gd_message_value,createdon" + base)
    ]).then(function (results) {
      var messages = results[1], notes = results[2], attachments = results[3];
      return loadNoteAttachments(notes).then(function (noteAtts) {
        render(messages, notes, attachments, noteAtts);
        setLoading(false);
      });
    }).catch(function (e) {
      setLoading(false);
      showError("Could not load the conversation: " + webApiError(e));
    });
  }

  // ── rendering ───────────────────────────────────────────────────────────────
  var CLIP_SVG = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg>';

  function attachmentChipHtml(att, extraClass) {
    return '<span class="att' + (extraClass ? " " + extraClass : "") + '" title="' + esc(att.name) + '">' +
      CLIP_SVG + "<span>" + esc(att.name) + "</span></span>";
  }

  function attachmentsHtml(atts) {
    if (!atts.length) return "";
    var chips = atts.map(function (a) {
      var html = attachmentChipHtml(a, a.internal ? "att--note" : "");
      if (a.isImage && a.id) {
        html += '<img class="attimg" data-attid="' + esc(a.id) + '" alt="' + esc(a.name) + '">';
      }
      return html;
    }).join("");
    return '<div class="atts">' + chips + "</div>";
  }

  function msgHtml(item) {
    var cls = item.kind === "note" ? "msg--vel msg--internal"
      : item.direction === DIRECTION_VELOPS ? "msg--vel" : "msg--cust";
    var tag = item.kind === "note" ? '<span class="tag">Note</span>'
      : item.direction === DIRECTION_VELOPS ? '<span class="tag">VelOps</span>' : "";
    return '<div class="msg ' + cls + '">' +
      '<div class="msg__avatar">' + esc(initials(item.author)) + "</div>" +
      '<div class="msg__body">' +
      '<div class="msg__who"><span class="name">' + esc(item.author || "Unknown") + "</span>" + tag +
      '<span class="when">' + esc(fmtWhen(item.when)) + "</span></div>" +
      '<div class="msg__bubble">' + esc(item.body || item.title || "") + "</div>" +
      attachmentsHtml(item.atts) +
      "</div></div>";
  }

  function render(messages, notes, attachments, noteAtts) {
    // attachments per message; unlinked ones go into the ticket-level strip
    var byMessage = {}, unlinked = [];
    attachments.forEach(function (a) {
      var att = {
        id: a.gd_ticketattachmentid,
        name: a.gd_name || "attachment",
        isImage: a.gd_isimage === true,
        internal: false
      };
      var msgId = a._gd_message_value;
      if (msgId) (byMessage[msgId] = byMessage[msgId] || []).push(att);
      else unlinked.push(att);
    });
    var byNote = {};
    (noteAtts || []).forEach(function (n) {
      var att = { id: null, name: n.filename || "attachment", isImage: false, internal: true };
      var noteId = n._objectid_value;
      if (noteId) (byNote[noteId] = byNote[noteId] || []).push(att);
    });

    var items = messages.map(function (m) {
      return {
        kind: "message",
        direction: m.gd_direction,
        author: m.gd_authorname || (m.gd_direction === DIRECTION_VELOPS ? "VelOps" : "Customer"),
        body: m.gd_body, title: m.gd_name, when: m.createdon,
        atts: byMessage[m.gd_supportmessageid] || []
      };
    }).concat(notes.map(function (n) {
      return {
        kind: "note",
        direction: DIRECTION_VELOPS,
        author: n.gd_authorname || "VelOps",
        body: n.gd_body, title: n.gd_name, when: n.createdon,
        atts: byNote[n.gd_internalnoteid] || []
      };
    }));
    items.sort(function (a, b) {
      return new Date(a.when).getTime() - new Date(b.when).getTime();
    });

    var ticketAttsEl = $("ticketAtts");
    if (unlinked.length) {
      ticketAttsEl.innerHTML = '<span class="ticketatts__label">Ticket attachments</span>' +
        unlinked.map(function (a) {
          var html = attachmentChipHtml(a);
          if (a.isImage) html += '<img class="attimg" data-attid="' + esc(a.id) + '" alt="' + esc(a.name) + '">';
          return html;
        }).join("");
      ticketAttsEl.classList.add("show");
    } else {
      ticketAttsEl.innerHTML = "";
      ticketAttsEl.classList.remove("show");
    }

    $("msgs").innerHTML = items.map(msgHtml).join("");
    $("thread").classList.add("show");
    $("emptyThread").classList.toggle("show", items.length === 0 && unlinked.length === 0);
    $("composer").classList.add("show");
    loadImagePreviews();
    var thread = $("thread");
    thread.scrollTop = thread.scrollHeight;
  }

  // Inline previews for image attachments: pull the file column bytes as a blob.
  function loadImagePreviews() {
    var imgs = document.querySelectorAll("img.attimg[data-attid]");
    Array.prototype.forEach.call(imgs, function (img) {
      var id = img.getAttribute("data-attid");
      img.removeAttribute("data-attid");
      fetch(clientUrl() + API + "gd_ticketattachments(" + id + ")/gd_file/$value")
        .then(function (r) { return r.ok ? r.blob() : null; })
        .then(function (blob) {
          if (blob && blob.size > 0) img.src = URL.createObjectURL(blob);
          else img.remove();
        })
        .catch(function () { img.remove(); });
    });
  }

  // ── composer ────────────────────────────────────────────────────────────────
  function renderPending() {
    var el = $("pending");
    el.innerHTML = state.pendingFiles.map(function (f, i) {
      return '<span class="att' + ($("internalChk").checked ? " att--note" : "") + '">' + CLIP_SVG +
        "<span>" + esc(f.name) + "</span>" +
        '<button type="button" data-i="' + i + '" title="Remove">&times;</button></span>';
    }).join("");
    Array.prototype.forEach.call(el.querySelectorAll("button"), function (b) {
      b.addEventListener("click", function () {
        state.pendingFiles.splice(Number(b.getAttribute("data-i")), 1);
        renderPending();
      });
    });
  }

  function applyToggleStyling() {
    var internal = $("internalChk").checked;
    $("toggleWrap").classList.toggle("is-on", internal);
    $("composer").classList.toggle("is-internal", internal);
    var send = $("sendBtn");
    send.classList.toggle("btn--internal", internal);
    send.classList.toggle("btn--primary", !internal);
    send.textContent = state.sending ? "Sending…" : internal ? "Add note" : "Send";
    $("body").placeholder = internal
      ? "Write an internal note — the customer never sees this…"
      : "Write a reply to the customer…";
    $("composerHint").textContent = internal
      ? "Internal notes (and their attachments) stay inside the VelOps team."
      : "Public replies are visible to the customer on the portal.";
    renderPending();
  }

  function setSending(on) {
    state.sending = on;
    $("sendBtn").disabled = on;
    $("attachBtn").disabled = on;
    $("body").disabled = on;
    applyToggleStyling();
    setLoading(on, "Sending…");
  }

  function readAsBase64(file) {
    return new Promise(function (resolve, reject) {
      var reader = new FileReader();
      reader.onload = function () {
        var result = String(reader.result || "");
        resolve(result.substring(result.indexOf(",") + 1)); // strip data: prefix
      };
      reader.onerror = function () { reject(new Error("Could not read " + file.name)); };
      reader.readAsDataURL(file);
    });
  }

  function uploadFileColumn(attachmentId, file) {
    return fetch(clientUrl() + API + "gd_ticketattachments(" + attachmentId + ")/gd_file", {
      method: "PATCH",
      headers: {
        "x-ms-file-name": file.name,
        "Content-Type": "application/octet-stream",
        "Accept": "application/json",
        "OData-MaxVersion": "4.0",
        "OData-Version": "4.0"
      },
      body: file
    }).then(function (r) {
      if (!r.ok) throw new Error("File upload failed for " + file.name + " (HTTP " + r.status + ")");
    });
  }

  function sendMessage(body, files) {
    var messageId;
    return Xrm.WebApi.createRecord("gd_supportmessage", {
      gd_name: body.substring(0, 80),
      gd_body: body,
      gd_direction: DIRECTION_VELOPS,
      gd_authorname: userName(),
      "gd_Ticket@odata.bind": "/gd_supporttickets(" + state.ticketId + ")"
    }).then(function (res) {
      messageId = res.id;
      return files.reduce(function (chain, file) {
        return chain.then(function () {
          return Xrm.WebApi.createRecord("gd_ticketattachment", {
            gd_name: file.name.substring(0, 400),
            gd_mimetype: (file.type || "application/octet-stream").substring(0, 200),
            gd_isimage: (file.type || "").indexOf("image/") === 0,
            "gd_Ticket@odata.bind": "/gd_supporttickets(" + state.ticketId + ")",
            "gd_Message@odata.bind": "/gd_supportmessages(" + messageId + ")"
          }).then(function (att) { return uploadFileColumn(att.id, file); });
        });
      }, Promise.resolve());
    }).then(function () {
      // First staff reply on a New ticket → offer to move it to In Review.
      if (state.statuscode !== STATUS_NEW) return;
      return Xrm.Navigation.openConfirmDialog({
        title: "Move to In Review?",
        text: "This ticket is still New. Move it to In Review now that VelOps has replied?",
        confirmButtonLabel: "Move to In Review",
        cancelButtonLabel: "Keep as New"
      }).then(function (result) {
        if (result && result.confirmed) {
          return Xrm.WebApi.updateRecord("gd_supportticket", state.ticketId, {
            statuscode: STATUS_IN_REVIEW
          });
        }
      });
    });
  }

  function sendInternalNote(body, files) {
    return Xrm.WebApi.createRecord("gd_internalnote", {
      gd_name: body.substring(0, 80),
      gd_body: body,
      gd_authorname: userName(),
      "gd_Ticket@odata.bind": "/gd_supporttickets(" + state.ticketId + ")"
    }).then(function (res) {
      var noteId = res.id;
      return files.reduce(function (chain, file) {
        return chain.then(function () {
          return readAsBase64(file).then(function (b64) {
            return Xrm.WebApi.createRecord("annotation", {
              subject: file.name,
              filename: file.name,
              mimetype: file.type || "application/octet-stream",
              documentbody: b64,
              isdocument: true,
              "objectid_gd_internalnote@odata.bind": "/gd_internalnotes(" + noteId + ")"
            });
          });
        });
      }, Promise.resolve());
    });
  }

  function onSend() {
    if (state.sending) return;
    var body = $("body").value.trim();
    if (!body) {
      showError("Type a message before sending.");
      return;
    }
    clearError();
    var internal = $("internalChk").checked;
    var files = state.pendingFiles.slice();
    setSending(true);
    (internal ? sendInternalNote(body, files) : sendMessage(body, files))
      .then(function () {
        $("body").value = "";
        state.pendingFiles = [];
        renderPending();
        setSending(false);
        return loadThread();
      })
      .catch(function (e) {
        setSending(false);
        showError("Could not send: " + webApiError(e));
      });
  }

  // ── bootstrap ───────────────────────────────────────────────────────────────
  function init() {
    if (!Xrm || !Xrm.WebApi) {
      showError("This panel must run inside a model-driven form (parent Xrm not found).");
      return;
    }
    state.ticketId = getTicketId();
    if (!state.ticketId) {
      $("emptyUnsaved").classList.add("show");
      return;
    }

    $("internalChk").addEventListener("change", applyToggleStyling);
    $("attachBtn").addEventListener("click", function () { $("fileInput").click(); });
    $("fileInput").addEventListener("change", function () {
      var input = $("fileInput");
      Array.prototype.forEach.call(input.files || [], function (f) {
        state.pendingFiles.push(f);
      });
      input.value = "";
      renderPending();
    });
    $("sendBtn").addEventListener("click", onSend);
    $("body").addEventListener("keydown", function (ev) {
      if ((ev.ctrlKey || ev.metaKey) && ev.key === "Enter") onSend();
    });

    applyToggleStyling();
    loadThread();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>
</body>
</html>
